rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if the user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    match /adminAllowlist/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Allow unauthenticated users to query for email existence (limit 1)
      allow list: if request.query.limit <= 1;
      
      // Admins can read/write any user document
      allow read, write: if isAdmin();
      
      // A user can read their own document
      allow read: if isAuth() && request.auth.uid == userId;
      
      // A user can create their own document. 
      // If they specify role 'admin', their email MUST be in the adminAllowlist.
      allow create: if isAuth() && request.auth.uid == userId &&
                    (
                      (request.resource.data.role == 'admin' && exists(/databases/$(database)/documents/adminAllowlist/$(request.resource.data.email))) ||
                      (request.resource.data.role == 'member')
                    );
                    
      // A user can update their own document, but cannot elevate themselves to admin without being in the allowlist.
      allow update: if isAuth() && request.auth.uid == userId &&
                    (
                      // Role is unchanged
                      request.resource.data.role == resource.data.role ||
                      // Or they are changing to admin AND are in the allowlist
                      (request.resource.data.role == 'admin' && exists(/databases/$(database)/documents/adminAllowlist/$(request.resource.data.email))) ||
                      // Or they are changing to member
                      request.resource.data.role == 'member'
                    );
    }
    
    match /leads/{leadId} {
      // Admins can read/write any lead
      allow read, write: if isAdmin();
      
      // Team Members can read/write ONLY their own leads
      allow read, write: if isAuth() && resource.data.ownerUid == request.auth.uid;
      
      // Allow creating a new lead if the user sets themselves as the owner
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
    }
    
    match /deals/{dealId} {
      allow read, write: if isAdmin();
      allow read, write: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
    }
    
    match /followUps/{followUpId} {
      allow read, write: if isAdmin();
      allow read, write: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
    }
    
    match /marks_log/{markId} {
      allow read, write: if isAuth();
    }

    match /teams/{teamId} {
      allow read, write: if isAuth();
    }

    match /invitations/{invitationId} {
      allow read, write: if isAuth();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // Fallback: Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
