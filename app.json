{
  "expo": {
    "name": "POOROJ",
    "slug": "POOROJ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pooraj-icon.png",
    "scheme": "pooraj",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pooraj.crm",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pooraj-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow POOROJ to access your contacts to quickly find and select saved contacts locally on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/pooraj-icon.png",
          "color": "#0ea5e9",
          "sounds": ["./assets/sounds/reminder.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
