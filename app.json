{
  "expo": {
    "name": "POORAJ",
    "slug": "POORAJ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pooraj-icon.png",
    "scheme": "pooraj",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pooraj-icon.png",
      "bundleIdentifier": "com.pooraj.crm",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["whatsapp", "tel", "telprompt"]
      }
    },
    "android": {
      "package": "com.pooraj.crm",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pooraj-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/pooraj-splash-final-v2.jpg",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/pooraj-splash-final-v2.jpg"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
