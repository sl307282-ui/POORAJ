{
  "expo": {
    "name": "POORAJ",
    "slug": "POORAJ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pooraj-icon.png",
    "scheme": "pooraj",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pooraj.crm",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pooraj-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/pooraj-icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/pooraj-icon.png"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
